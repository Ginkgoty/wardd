[Unit]
Description=Download and stage a wardd GeoIP snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/wardctl geo update
UMask=0077

# This unit parses a downloaded MMDB through libmaxminddb. It is the largest
# untrusted-input surface in the product, so it is confined tightly. It only
# downloads and stages a snapshot; activation is a separate explicit command,
# which is why /etc/wardd/generated stays read-only here.
StateDirectory=wardd
StateDirectoryMode=0750
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/wardd

