[Unit]
Description=wardd lightweight edge firewall
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/wardd --config /etc/wardd/wardd.toml --socket /run/wardd/wardd.sock
ExecStop=/usr/sbin/wardctl --socket /run/wardd/wardd.sock shutdown
Restart=on-failure
RestartSec=2s
RuntimeDirectory=wardd
RuntimeDirectoryMode=0750
StateDirectory=wardd
StateDirectoryMode=0750
UMask=0027

# The daemon never mutates the data plane: it reads XDP attachment status and
# the pinned runtime_cfg map. Attach, detach and map writes are wardctl only.
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_NETLINK is required by libbpf/libxdp; bpf is in @privileged, which
# @system-service excludes, so it is added back explicitly.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service bpf
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/wardd /var/lib/wardd

[Install]
WantedBy=multi-user.target
